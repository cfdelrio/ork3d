# Copiar a admin/.env y completar. Las variables ya exportadas en el entorno tienen prioridad.
# No pongas credenciales acá: la CLI usa tu perfil de AWS (aws configure o SSO).

# Bucket privado de reseñas. Los nombres S3 son globales: usá el que imprime infra/resenas-setup.sh
# (ork3d-resenas-privado-<ACCOUNT_ID>), reemplazando el placeholder por tu account ID real en TU máquina.
RESENAS_BUCKET=ork3d-resenas-privado-REEMPLAZAR-CON-TU-ACCOUNT-ID
SITE_BUCKET=ork3d.com

# ID de la distribución de CloudFront. Vacío = se omite la invalidación (con aviso).
CF_DISTRIBUTION_ID=

SITE_URL=https://ork3d.com

# Días de validez de cada link de opinión.
TOKEN_DAYS=60

# Comando de AWS CLI v2 (puede tener espacios).
AWS_CMD=aws

# Carpeta para fotos privadas (comando ver) y backups por defecto. Vacío = admin/out.
# ADMIN_OUT_DIR=/ruta/fuera/del/repo
